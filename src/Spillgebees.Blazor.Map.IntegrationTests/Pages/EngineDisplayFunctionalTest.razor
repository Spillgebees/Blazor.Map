@page "/engine-display-functional-test"

<main class="e2e-shell">
    <h1>Engine display functional test</h1>
    <p>Display items toggling runtime layers, feature filters, base-style layers and composed overlay-style layers.</p>

    <section style="display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1rem;">
        <button type="button" data-testid="toggle-points" @onclick="@(() => _display.Toggle("points"))">Toggle points</button>
        <button type="button" data-testid="toggle-express" @onclick="@(() => _display.Toggle("express"))">Toggle express</button>
        <button type="button" data-testid="toggle-display-overlay-style" @onclick="@(() => _display.Toggle("overlay-style"))">Toggle display overlay style</button>
        <button type="button" data-testid="toggle-display-overlay-secondary" @onclick="@(() => _display.Toggle("overlay-secondary"))">Toggle display secondary</button>
        <button type="button"
                data-testid="toggle-planned-corridor"
                @onclick="@(() => _display.Toggle("planned-corridor"))">Toggle planned corridor</button>
        <button type="button" data-testid="toggle-base" @onclick="@(() => _display.Toggle("base"))">Toggle base raster</button>
        <button type="button" data-testid="add-overlay-style" @onclick="AddOverlayStyle">Add second overlay style</button>
    </section>

    @if (_lastError is not null)
    {
        <p style="color: #b91c1c;" data-testid="map-error">@_lastError</p>
    }

    <div id="engine-display-frame" class="stress-map-frame">
        <SgbMap Styles="@_styles"
                Display="@_display"
                Center="@(new Coordinate(49.61, 6.14))"
                Zoom="12"
                Height="480px"
                Width="100%"
                OnMapError="@HandleMapError">
            <GeoJsonSource Id="disp" Data="@DataJson">
                <CircleLayer Id="disp-points"
                               Radius="8"
                               Color="@("#dc2626")"
                               Filter="@_baselineFilter" />
            </GeoJsonSource>

            <MapControls>
                <DisplayMapControl Id="display-ctrl"
                                   Label="Display"
                                   InitiallyOpen="true"
                                   Position="ControlPosition.BottomLeft"
                                   ItemIds="@(["extras"])" />
            </MapControls>
        </SgbMap>
    </div>
</main>

@code {
    private static readonly MapStyle _baseStyle = MapStyle
        .FromRasterUrl(
            "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAIAAACQd1PeAAAADElEQVR4nGM4YWMDAAMQAUEiFmcFAAAAAElFTkSuQmCC",
            "base"
        )
        .WithId("base");

    private static readonly MapStyle _overlayStyle = MapStyle.FromUrl("/test-overlay-style.json").WithId("annotations");

    private static readonly MapStyle _secondOverlayStyle = MapStyle
        .FromUrl("/test-overlay-style.json")
        .WithId("annotations-2");

    private static readonly object _baselineFilter = new object[] { "has", "name" };

    private const string DataJson = """
        {"type":"FeatureCollection","features":[
            {"type":"Feature","geometry":{"type":"Point","coordinates":[6.13,49.605]},"properties":{"name":"a","kind":"normal"}},
            {"type":"Feature","geometry":{"type":"Point","coordinates":[6.15,49.615]},"properties":{"name":"b","kind":"express"}}
        ]}
        """;

    private IReadOnlyList<MapStyle> _styles = [_baseStyle, _overlayStyle];

    private readonly MapDisplayState _display = new(
        [
            new MapDisplayItem("points", [MapDisplayTarget.Layers("disp-points")], Label: "Points"),
            new MapDisplayItem("base", [MapDisplayTarget.StyleLayers("base", "raster-layer")], Label: "Base raster"),
            new MapDisplayItem("overlay-style", [MapDisplayTarget.Style("annotations")], Label: "Overlay style"),
            new MapDisplayItem(
                "planned-corridor",
                [MapDisplayTarget.StyleLayers("annotations", "planned-corridor-line")],
                IsOn: false,
                Label: "Planned corridor"
            ),
            new MapDisplayItem(
                "overlay-secondary",
                [MapDisplayTarget.StyleLayers("annotations", "overlay-secondary-circle")],
                Label: "Overlay secondary"
            ),
            // unset: follows the overlay style, which ships its tagged layer hidden
            new MapDisplayItem("extras", [MapDisplayTarget.StyleTags("annotations", "extras")], Label: "Extras"),
            new MapDisplayItem(
                "express",
                [
                    MapDisplayTarget
                        .Layers("disp-points")
                        .Where(new object[] { "==", new object[] { "get", "kind" }, "express" }),
                ],
                Label: "Express features"
            ),
        ]
    );

    private string? _lastError;

    private void AddOverlayStyle() => _styles = [_baseStyle, _overlayStyle, _secondOverlayStyle];

    private void HandleMapError(Exception exception)
    {
        _lastError = exception.Message;
        StateHasChanged();
    }
}
