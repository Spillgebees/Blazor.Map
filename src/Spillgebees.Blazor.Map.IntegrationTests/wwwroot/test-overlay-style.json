{
    "version": 8,
    "sources": {
        "overlay-points": {
            "type": "geojson",
            "data": {
                "type": "FeatureCollection",
                "features": [
                    {
                        "type": "Feature",
                        "geometry": { "type": "Point", "coordinates": [6.14, 49.61] },
                        "properties": { "name": "overlay-marker" }
                    },
                    {
                        "type": "Feature",
                        "geometry": { "type": "Point", "coordinates": [6.145, 49.61] },
                        "properties": { "name": "overlay-secondary-marker" }
                    },
                    {
                        "type": "Feature",
                        "geometry": { "type": "Point", "coordinates": [6.135, 49.61] },
                        "properties": { "name": "overlay-extra-marker" }
                    },
                    {
                        "type": "Feature",
                        "geometry": {
                            "type": "LineString",
                            "coordinates": [
                                [6.105, 49.598],
                                [6.125, 49.605],
                                [6.15, 49.618],
                                [6.172, 49.626]
                            ]
                        },
                        "properties": { "name": "planned-corridor" }
                    }
                ]
            }
        }
    },
    "layers": [
        {
            "id": "overlay-circle",
            "type": "circle",
            "source": "overlay-points",
            "filter": ["==", ["get", "name"], "overlay-marker"],
            "paint": { "circle-radius": 10, "circle-color": "#d946ef" }
        },
        {
            "id": "overlay-secondary-circle",
            "type": "circle",
            "source": "overlay-points",
            "filter": ["==", ["get", "name"], "overlay-secondary-marker"],
            "paint": { "circle-radius": 10, "circle-color": "#22c55e" }
        },
        {
            "id": "planned-corridor-line",
            "type": "line",
            "source": "overlay-points",
            "filter": ["==", ["get", "name"], "planned-corridor"],
            "layout": { "line-join": "round", "line-cap": "round" },
            "paint": { "line-color": "#f59e0b", "line-width": 5, "line-opacity": 0.9 }
        },
        {
            "id": "overlay-extra-circle",
            "type": "circle",
            "source": "overlay-points",
            "filter": ["==", ["get", "name"], "overlay-extra-marker"],
            "metadata": { "sgb:tags": ["extras"] },
            "layout": { "visibility": "none" },
            "paint": { "circle-radius": 10, "circle-color": "#0ea5e9" }
        }
    ]
}
