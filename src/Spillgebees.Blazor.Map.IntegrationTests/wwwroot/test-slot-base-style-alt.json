{
    "version": 8,
    "glyphs": "/fonts/{fontstack}/{range}.pbf",
    "sources": {
        "alt-points": {
            "type": "geojson",
            "data": {
                "type": "FeatureCollection",
                "features": [
                    {
                        "type": "Feature",
                        "geometry": { "type": "Point", "coordinates": [6.14, 49.61] },
                        "properties": { "name": "alt-marker" }
                    }
                ]
            }
        }
    },
    "layers": [
        { "id": "alt-background", "type": "background", "paint": { "background-color": "#dbeafe" } },
        {
            "id": "alt-ground",
            "type": "circle",
            "source": "alt-points",
            "paint": { "circle-radius": 16, "circle-color": "#93c5fd" }
        },
        { "id": "alt-labels", "type": "symbol", "source": "alt-points", "layout": { "text-field": "" } }
    ]
}
