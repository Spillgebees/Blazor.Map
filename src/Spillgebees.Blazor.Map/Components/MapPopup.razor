@namespace Spillgebees.Blazor.Map
@implements IAsyncDisposable
@using Microsoft.JSInterop
@using Spillgebees.Blazor.Map

<div style="display:none" @ref="_placeholderReference" data-sgb-popup-placeholder="@_resolvedId">
    <div @ref="_contentReference">
        @ChildContent
    </div>
</div>

@code {
    private ElementReference _placeholderReference;
    private ElementReference _contentReference;
    private string _resolvedId = string.Empty;
    private string? _registeredId;
    private bool _contentRegistered;
    private PopupContentSnapshot? _lastSnapshot;
    private Task? _pendingReadyRegistrationTask;
    private CancellationTokenSource? _pendingReadyRegistrationCancellation;
    private bool _isDisposed;

    [CascadingParameter]
    private IMapInteropHost? Map { get; set; }

    [CascadingParameter]
    private MapSectionContext? SectionContext { get; set; }

    /// <summary>Popup id; auto-generated when not set.</summary>
    [Parameter]
    public string? Id { get; set; }

    /// <summary>Popup anchor position.</summary>
    [Parameter, EditorRequired]
    public Coordinate Position { get; set; }

    /// <summary>Whether the popup is shown. Defaults to true. Supports @bind-Open.</summary>
    [Parameter]
    public bool Open { get; set; } = true;

    /// <summary>Fires when the popup is closed by the user; args carry the new open state (false).</summary>
    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>Popup display options (offset, anchor, close behavior, ...).</summary>
    [Parameter]
    public PopupOptions? Options { get; set; }

    /// <summary>The popup's rendered content.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    protected override void OnInitialized()
    {
        _resolvedId = string.IsNullOrWhiteSpace(Id) ? $"popup-{Guid.NewGuid():N}" : Id;
    }

    protected override void OnParametersSet()
    {
        ValidatePlacement();
        ValidateParameters();

        if (!string.IsNullOrWhiteSpace(Id))
        {
            _resolvedId = Id;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_isDisposed || Map is null)
        {
            return;
        }

        if (Open)
        {
            if (!Map.RuntimeIsReady)
            {
                QueueRegistrationWhenMapIsReady(Map);
                return;
            }

            await RegisterOpenPopupAsync();
            return;
        }

        if (_contentRegistered)
        {
            await RemovePopupContentAsync();
        }
    }

    private void QueueRegistrationWhenMapIsReady(IMapInteropHost map)
    {
        if (_pendingReadyRegistrationTask is { IsCompleted: false })
        {
            return;
        }

        _pendingReadyRegistrationCancellation?.Dispose();
        _pendingReadyRegistrationCancellation = new CancellationTokenSource();
        _pendingReadyRegistrationTask = RegisterWhenMapIsReadyAsync(map, _pendingReadyRegistrationCancellation.Token);
    }

    private async Task RegisterWhenMapIsReadyAsync(IMapInteropHost map, CancellationToken cancellationToken)
    {
        try
        {
            var mapReady = await map.WhenReadyAsync();

            if (!mapReady || cancellationToken.IsCancellationRequested || _isDisposed || Map != map || !Open)
            {
                return;
            }

            await InvokeAsync(async () =>
            {
                if (!cancellationToken.IsCancellationRequested && !_isDisposed)
                {
                    await RegisterOpenPopupAsync();
                }
            });
        }
        catch (Exception exception)
        {
            await DispatchExceptionAsync(exception);
        }
        finally
        {
            _pendingReadyRegistrationTask = null;
            _pendingReadyRegistrationCancellation?.Dispose();
            _pendingReadyRegistrationCancellation = null;
        }
    }

    private async Task RegisterOpenPopupAsync()
    {
        if (_isDisposed || Map is null || !Open)
        {
            return;
        }

        var options = Options ?? PopupOptions.FromText(string.Empty);
        var snapshot = new PopupContentSnapshot(_resolvedId, Position, options, ChildContent);

        if (_contentRegistered && _registeredId == _resolvedId && snapshot == _lastSnapshot)
        {
            return;
        }

        if (_contentRegistered && _registeredId is not null && _registeredId != _resolvedId)
        {
            await RemovePopupContentAsync(_registeredId);
        }

        await Map.SetPopupContentAsync(
            _resolvedId,
            Position,
            options,
            _placeholderReference,
            _contentReference,
            OnPopupClosedAsync
        );
        _contentRegistered = true;
        _registeredId = _resolvedId;
        _lastSnapshot = snapshot;
    }

    /// <summary>Removes the popup content from the host map.</summary>
    public async ValueTask DisposeAsync()
    {
        if (_isDisposed)
        {
            return;
        }

        _isDisposed = true;
        _pendingReadyRegistrationCancellation?.Cancel();
        _pendingReadyRegistrationCancellation?.Dispose();
        _pendingReadyRegistrationCancellation = null;
        await RemovePopupContentAsync();
    }

    internal async Task OnPopupClosedAsync()
    {
        if (_isDisposed || !Open)
        {
            return;
        }

        _contentRegistered = false;
        _registeredId = null;
        _lastSnapshot = null;

        await OpenChanged.InvokeAsync(false);
    }

    private async ValueTask RemovePopupContentAsync()
    {
        if (Map is null || !_contentRegistered)
        {
            return;
        }

        await RemovePopupContentAsync(_registeredId ?? _resolvedId);
    }

    private async ValueTask RemovePopupContentAsync(string popupId)
    {
        if (Map is null)
        {
            return;
        }

        await Map.RemovePopupContentAsync(popupId);
        _contentRegistered = false;
        _registeredId = null;
        _lastSnapshot = null;
    }

    private void ValidatePlacement()
    {
        if (Map is null)
        {
            throw new InvalidOperationException("MapPopup must be placed inside SgbMap.");
        }

        if (SectionContext?.Kind is not MapContentSectionKind.Features)
        {
            throw new InvalidOperationException("MapPopup must be placed inside MapFeatures.");
        }
    }

    private void ValidateParameters()
    {
        if (Position is null)
        {
            throw new InvalidOperationException("MapPopup requires Position.");
        }
    }

    private sealed record PopupContentSnapshot(
        string Id,
        Coordinate Position,
        PopupOptions Options,
        RenderFragment? ChildContent
    );
}
