@namespace Spillgebees.Blazor.Map

<div class="sgb-map-root">
    <div @ref="_container" id="@ContainerId" class="sgb-map-container @ContainerClass" style="height: @Height; width: @Width;"></div>
    <CascadingValue Value="this" IsFixed="true">
        <CascadingValue Value="ControlRegistry" IsFixed="true">
            <CascadingValue Value="RootContext" IsFixed="true">
                <CascadingValue Value="Display">
                    @ChildContent
                </CascadingValue>
            </CascadingValue>
        </CascadingValue>
    </CascadingValue>
</div>
