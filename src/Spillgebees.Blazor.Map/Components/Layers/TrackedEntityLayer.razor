@namespace Spillgebees.Blazor.Map
@using Spillgebees.Blazor.Map
@typeparam TItem

<GeoJsonSource Id="@SourceId"
               @ref="_primarySource"
               AllowOutsideMapSources="true"
               Data="@_primaryData"
                LayerGroup="@LayerGroup"
                BeforeLayerGroup="@BeforeLayerGroup"
                AfterLayerGroup="@AfterLayerGroup"
               ClusterOptions="@GetPrimarySourceClusterOptions()"
               ClusterProperties="@GetClusterProperties()"
               MaxZoom="@MaxZoom"
               Attribution="@Attribution"
               Animation="@Animation">
    @if (ShouldRenderClusterHitArea())
    {
        <CircleLayer Id="@ClusterHitAreaLayerId"
                     SourceId="@SourceId"
                     Filter="@ClusterFilter"
                     Radius="@ClusterHitAreaRadiusValue"
                     Color="@("#000000")"
                     Opacity="0"
                      PitchAlignment="CirclePitchAlignment.Viewport"
                      LayerGroup="@ClusterHitAreaLayerId"
                      Visible="@Visible"
                      OnClick="@HandleGeneratedClusterClickAsync" />
    }
    @for (var clusterLayerIndex = 0; clusterLayerIndex < GetClusterLayerDefinitions().Count; clusterLayerIndex++)
    {
        var clusterLayer = GetClusterLayerDefinitions()[clusterLayerIndex];
        var clusterLayerId = GetClusterLayerId(clusterLayer);
        var afterLayerGroup = GetClusterLayerAfterLayerGroup(clusterLayerIndex);

        @if (clusterLayer is ClusterCircleLayerDefinition circleLayer)
        {
            <CircleLayer Id="@clusterLayerId"
                         SourceId="@SourceId"
                         Filter="@ClusterFilter"
                         Radius="@circleLayer.Radius"
                         Color="@circleLayer.Color"
                         Opacity="@circleLayer.Opacity"
                         StrokeColor="@circleLayer.StrokeColor"
                         StrokeWidth="@circleLayer.StrokeWidth"
                          MinZoom="@circleLayer.MinZoom"
                          MaxZoom="@circleLayer.MaxZoom"
                         BeforeLayerId="@circleLayer.BeforeLayerId"
                         LayerGroup="@circleLayer.LayerGroup"
                         BeforeLayerGroup="@circleLayer.BeforeLayerGroup"
                         AfterLayerGroup="@afterLayerGroup"
                         PitchAlignment="CirclePitchAlignment.Viewport"
                         Visible="@(Visible && circleLayer.Visible)"
                         OnClick="@HandleGeneratedClusterClickAsync" />
        }
        else if (clusterLayer is ClusterSymbolLayerDefinition symbolLayer)
        {
            <SymbolLayer Id="@clusterLayerId"
                         SourceId="@SourceId"
                         Filter="@ClusterFilter"
                         TextField="@GetClusterSymbolTextField(symbolLayer)"
                         TextSize="@symbolLayer.TextSize"
                         TextColor="@symbolLayer.TextColor"
                          MinZoom="@symbolLayer.MinZoom"
                          MaxZoom="@symbolLayer.MaxZoom"
                         BeforeLayerId="@symbolLayer.BeforeLayerId"
                         LayerGroup="@symbolLayer.LayerGroup"
                         BeforeLayerGroup="@symbolLayer.BeforeLayerGroup"
                         AfterLayerGroup="@afterLayerGroup"
                         TextPitchAlignment="MapAlignment.Viewport"
                         TextRotationAlignment="MapAlignment.Viewport"
                         TextAllowOverlap="true"
                         Visible="@(Visible && symbolLayer.Visible)"
                         OnClick="@HandleGeneratedClusterClickAsync" />
        }
    }

    <SymbolLayer Id="@PrimaryLayerId"
                 SourceId="@SourceId"
                 Filter="@PrimaryFilter"
                 IconImage="@Expr.Get(TrackedEntityFeatureProperties.IconImage)"
                 IconSize="@PrimaryIconSizeValue"
                 IconOpacity="@(PrimaryIconOpacity ?? 1.0)"
                 IconRotate="@PrimaryIconRotateValue"
                 IconOffset="@PrimaryIconOffsetValue"
                 IconAnchor="@PrimaryIconAnchorValue"
                 IconAllowOverlap="true"
                  RotationAlignment="MapAlignment.Map"
                 SymbolSortKey="@RenderOrderSortKeyValue"
                  AfterLayerGroup="@PrimaryAfterLayerGroup"
                 Visible="@Visible"
                 OnClick="@HandleGeneratedItemClickAsync"
                 OnMouseEnter="@HandleGeneratedItemMouseEnterAsync"
                 OnMouseLeave="@HandleGeneratedItemMouseLeaveAsync" />

    <CircleLayer Id="@PrimaryHitAreaLayerId"
                 SourceId="@SourceId"
                 Filter="@PrimaryFilter"
                 Radius="24"
                 Color="@("#000000")"
                 Opacity="0"
                  PitchAlignment="CirclePitchAlignment.Viewport"
                  AfterLayerGroup="@PrimaryLayerId"
                 Visible="@Visible"
                 OnClick="@HandleGeneratedItemClickAsync"
                 OnMouseEnter="@HandleGeneratedItemMouseEnterAsync"
                 OnMouseLeave="@HandleGeneratedItemMouseLeaveAsync" />
</GeoJsonSource>

@if (HasDecorations)
{
    <GeoJsonSource Id="@DecorationSourceId"
                   AllowOutsideMapSources="true"
                   Data="@_decorationData"
                    LayerGroup="@LayerGroup"
                    BeforeLayerGroup="@BeforeLayerGroup"
                    AfterLayerGroup="@AfterLayerGroup"
                   ClusterOptions="@GetDecorationClusterOptions()"
                   PromoteId="entityId"
                   MaxZoom="@MaxZoom">
        @foreach (var decorationLayer in DecorationLayers)
        {
            <SymbolLayer Id="@decorationLayer.LayerId"
                         SourceId="@DecorationSourceId"
                         Filter="@GetDecorationFilter(decorationLayer)"
                         TextField="@Expr.Get(TrackedEntityFeatureProperties.Text)"
                         TextSize="@DecorationTextSizeValue"
                         TextFont="@decorationLayer.TextFont"
                         TextColor="@DecorationColorValue"
                         TextAnchor="@GetResolvedAnchor(decorationLayer.Anchor)"
                         TextOffset="@GetDecorationTextOffsetValue(decorationLayer.Decoration)"
                         TextMaxWidth="999"
                          TextPitchAlignment="MapAlignment.Viewport"
                          TextRotationAlignment="MapAlignment.Viewport"
                         TextAllowOverlap="true"
                         TextHaloColor="@DecorationHaloColorValue"
                         TextHaloWidth="@DecorationHaloWidthValue"
                         TextOpacity="@DecorationVisibilityOpacityValue"
                         IconImage="@(decorationLayer.HasIcon ? (StyleValue<string>?)Expr.Get(TrackedEntityFeatureProperties.IconImage) : null)"
                         IconSize="@(decorationLayer.HasIcon ? (StyleValue<double>?)DecorationIconSizeValue : null)"
                         IconRotate="@(decorationLayer.HasIcon ? (StyleValue<double>?)DecorationIconRotateValue : null)"
                         IconOffset="@(decorationLayer.HasIcon && decorationLayer.IconTextFit is null ? (StyleValue<double[]>?)DecorationIconOffsetValue : null)"
                          IconAnchor="@(decorationLayer.HasIcon ? (StyleValue<SymbolAnchor>?)GetResolvedAnchor(decorationLayer.Anchor) : null)"
                         IconAllowOverlap="@(decorationLayer.HasIcon)"
                         IconOpacity="@(decorationLayer.HasIcon ? (StyleValue<double>?)DecorationVisibilityOpacityValue : null)"
                         IconColor="@(decorationLayer.HasIcon ? (StyleValue<string>?)DecorationIconColorValue : null)"
                         IconTextFit="@decorationLayer.IconTextFit"
                         IconTextFitPadding="@decorationLayer.IconTextFitPadding"
                          RotationAlignment="MapAlignment.Map"
                         SymbolSortKey="@RenderOrderSortKeyValue"
                          AfterLayerGroup="@PrimaryHitAreaLayerId"
                         Visible="@Visible"
                         OnClick="@HandleGeneratedItemClickAsync"
                         OnMouseEnter="@HandleGeneratedItemMouseEnterAsync"
                         OnMouseLeave="@HandleGeneratedItemMouseLeaveAsync" />
        }
    </GeoJsonSource>
}
