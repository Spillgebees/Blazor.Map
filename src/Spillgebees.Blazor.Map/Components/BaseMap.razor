@namespace Spillgebees.Blazor.Map
@inherits ComponentBase
@using Spillgebees.Blazor.Map

@code {
    protected virtual RenderFragment Render
        => @<CascadingValue Value="this">
                <CascadingValue Value="new MapRootContext(this)">
                    <CascadingValue Value="ControlRegistry">
                        <CascadingValue Value="Display">
                            <div id="@ContainerId"
                                 class="@InternalContainerClass"
                                 style="@InternalContainerStyle"
                                 @ref="@MapReference">
                            </div>
                            @foreach (var legendControl in Controls.OfType<LegendControlDefinition>())
                            {
                                <DynamicComponent Type="typeof(LegendMapControlHost)"
                                                  Parameters="GetLegendControlHostParameters(legendControl)" />
                            }
                            @ChildContent
                        </CascadingValue>
                    </CascadingValue>
                </CascadingValue>
            </CascadingValue>;
}
