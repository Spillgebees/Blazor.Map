@namespace Spillgebees.Blazor.Map

<div @ref="_placeholderReference" data-sgb-control-placeholder="@Id" class="sgb-map-custom-control-placeholder" hidden>
    <div id="@_contentId" @ref="_contentReference" class="sgb-map-custom-control-content" hidden>
        <div class="@_groupClass" aria-label="@Label">
            <button type="button"
                    class="@_buttonClass"
                    aria-label="@Label"
                    title="@_effectiveTitle"
                    disabled="@Disabled"
                    @onclick="OnClick">
                @if (Icon is not null)
                {
                    <span class="sgb-map-control-icon" aria-hidden="true">
                        @Icon
                    </span>
                }
                @if (!string.IsNullOrWhiteSpace(Text))
                {
                    <span class="sgb-map-control-text">@Text</span>
                }
            </button>
        </div>
    </div>
</div>
