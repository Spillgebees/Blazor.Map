@using Spillgebees.Blazor.Map

<SgbMap Center="@(new Coordinate(49.6117, 6.1319))"
        Zoom="12"
        Style="@(MapStyle.OpenFreeMap.Liberty)"
        Display="@_display"
        Height="450px"
        Width="100%"
        @ref="_map">
    <MapControls>
        <NavigationMapControl Position="ControlPosition.TopRight" Order="10" />
        <FullscreenMapControl Position="ControlPosition.TopRight" Order="20" />
        <CenterMapControl Position="ControlPosition.TopLeft" Order="5" />
        <ScaleMapControl Position="ControlPosition.BottomLeft" Order="5" />

        <ButtonMapControl Id="station-focus"
                          Position="ControlPosition.TopLeft"
                          Order="15"
                          Label="@FocusActionLabel"
                          Title="@FocusActionLabel"
                          Text="@FocusText"
                          OnClick="FocusNextStationAsync">
            <Icon>
                <svg class="docs-station-focus-icon"
                     viewBox="0 0 24 24"
                     aria-hidden="true"
                     focusable="false">
                    <path d="M12 21s6-5.1 6-11a6 6 0 1 0-12 0c0 5.9 6 11 6 11Z"
                          fill="none"
                          stroke="currentColor"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2" />
                    <circle cx="12"
                            cy="10"
                            r="2"
                            fill="currentColor" />
                </svg>
            </Icon>
        </ButtonMapControl>

        <DisplayMapControl Id="network-display"
                           Position="ControlPosition.TopRight"
                           Order="40"
                           InitiallyOpen="true" />

        <PanelMapControl Id="network-options"
                         Position="ControlPosition.TopRight"
                         Order="45"
                         Label="Network options"
                         Title="Network options">
            <label class="docs-map-option">
                <input type="checkbox" @bind="_showStationNames" />
                Station labels
            </label>
        </PanelMapControl>

        <LegendMapControl Id="network-legend"
                          Position="ControlPosition.TopRight"
                          Order="50"
                          Title="Legend"
                          Collapsible="true"
                          InitiallyOpen="false"
                          Definition="@_legendDefinition" />
    </MapControls>

    <MapSources>
        <GeoJsonSource Id="network"
                       Data="@NetworkData">
            <LineLayer Id="metro-line"
                       Color="@("#2563eb")"
                       Width="4" />
            <CircleLayer Id="station-layer"
                         Color="@("#f97316")"
                         Radius="5"
                         StrokeColor="@("#ffffff")"
                         StrokeWidth="2" />
        </GeoJsonSource>
    </MapSources>
</SgbMap>

@code {
    private readonly StationFeature[] _stations =
    [
        new("Central Station", [6.1319, 49.6117]),
        new("North Station", [6.1600, 49.6200]),
        new("West Station", [6.0950, 49.6030]),
    ];

    private SgbMap? _map;
    private object? _networkData;
    private int _nextStationIndex;
    private string? _focusedStationName;
    private bool _showStationNames = true;
    private readonly MapDisplayState _display =
        new(
            [
                new MapDisplayItem(
                    "metro-lines",
                    [MapDisplayTarget.RuntimeLayers("metro-line")],
                    Label: "Metro lines"
                ),
                new MapDisplayItem(
                    "stations",
                    [MapDisplayTarget.RuntimeLayers("station-layer")],
                    Label: "Stations"
                ),
            ]
        );

    private StationFeature NextStation => _stations[_nextStationIndex];

    private string FocusLabel => _focusedStationName is null ? NextStation.Name : $"Focused {_focusedStationName}";

    private string FocusActionLabel => $"Focus {NextStation.Name}";

    private string FocusText => $"Focus station: {FocusLabel}";

    private object NetworkData =>
        _networkData ??= new
        {
            type = "FeatureCollection",
            features = CreateNetworkFeatures(),
        };

    private readonly MapLegend _legendDefinition =
        new(
            [
                new MapLegendSection(
                    "Transit",
                    [
                        new MapLegendItem(
                            Id: "metro-lines",
                            Label: "Metro lines",
                            DisplayItemId: "metro-lines",
                            Symbol: MapLegendSymbol.Line("#2563eb", 4)
                        ),
                        new MapLegendItem(
                            Id: "stations",
                            Label: "Stations",
                            DisplayItemId: "stations",
                            Symbol: MapLegendSymbol.Circle("#f97316", "#ffffff")
                        ),
                    ]
                ),
            ]
        );

    private object[] CreateNetworkFeatures()
    {
        var features = new List<object>
        {
            new
            {
                type = "Feature",
                properties = new { name = "Line A", kind = "line" },
                geometry = new
                {
                    type = "LineString",
                    coordinates = new[]
                    {
                        new[] { 6.0950, 49.6030 },
                        new[] { 6.1319, 49.6117 },
                        new[] { 6.1600, 49.6200 },
                    },
                },
            },
        };

        features.AddRange(_stations.Select(CreateStationFeature));

        return [.. features];
    }

    private static object CreateStationFeature(StationFeature station) =>
        new
        {
            type = "Feature",
            properties = new { name = station.Name, kind = "station" },
            geometry = new
            {
                type = "Point",
                coordinates = station.Coordinates,
            },
        };

    private async Task FocusNextStationAsync()
    {
        var station = NextStation;
        _focusedStationName = station.Name;
        _nextStationIndex = (_nextStationIndex + 1) % _stations.Length;

        if (_map is not null)
        {
            await _map.FlyToAsync(station.ToCoordinate(), zoom: 14);
        }
    }

    private sealed record StationFeature(string Name, double[] Coordinates)
    {
        public Coordinate ToCoordinate() => new(Coordinates[1], Coordinates[0]);
    }
}
