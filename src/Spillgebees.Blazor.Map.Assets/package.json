{
  "private": true,
  "name": "spillgebees.blazor.map.assets",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.26.0+sha512.fc0e2bf890b9f983611f1ab68c0637bce914390653699f83c1a78b005ed25f2c81e77920c8fd8eee2ecf0b58b28cdcb00a84d97f69bcf7c56b2f344710238664",
  "description": "TypeScript module housing assets related to the Spillgebees.Blazor.Map NuGet package.",
  "author": "Jason Rebelo Neves (igotinfected)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Spillgebees/Blazor.Map.git"
  },
  "bugs": {
    "url": "https://github.com/Spillgebees/Blazor.Map/issues"
  },
  "homepage": "https://github.com/Spillgebees/Blazor.Map#readme",
  "keywords": [],
  "scripts": {
    "build:dev": "vite build --mode development",
    "build:prod": "vite build --mode production",
    "clean": "rimraf ../Spillgebees.Blazor.Map/wwwroot",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test --project docs --project integration",
    "test:browser:docs": "playwright test --project docs",
    "test:browser:integration": "playwright test --project integration",
    "test:browser:perf": "playwright test --project perf --workers 1",
    "test:browser:perf:record": "PERF_RECORD=1 playwright test --project perf --workers 1",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "maplibre-gl": "5.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@microsoft/dotnet-js-interop": "10.0.11",
    "@playwright/test": "1.62.1",
    "@types/geojson": "7946.0.16",
    "@types/node": "26.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "30.0.1",
    "rimraf": "6.1.3",
    "sass": "1.103.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
